{
  "name": "@theozer/deno-lint-rules",
  "version": "0.5.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./packages": "./packages.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "mod.ts",
      "packages.ts",
      "rules/import-specifier.ts",
      "rules/no-bare-cross-package-specifier.ts",
      "rules/no-relative-cross-package-import.ts",
      "rules/no-service-relative-package-import.ts",
      "rules/no-terraform-alert-env.ts",
      "rules/no-terraform-alert-placement.ts",
      "rules/no-terraform-content-gate.ts",
      "rules/terraform-workflow-contract.ts",
      "rules/no-unsafe-terraform-alert-payload.ts",
      "rules/terraform-alert-contract.ts",
      "rules/terraform-alert-contract-text.ts"
    ]
  },
  "tasks": {
    "check": "deno check",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --allow-run --allow-read --allow-write --allow-env"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ]
    }
  }
}

{
  "name": "@theozer/deno-lint-rules",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./packages": "./packages.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "mod.ts",
      "packages.ts",
      "rules/no-bare-cross-package-specifier.ts",
      "rules/no-relative-cross-package-import.ts",
      "rules/no-service-relative-package-import.ts"
    ]
  },
  "tasks": {
    "check": "deno check mod.ts packages.ts mod.test.ts entrypoints.test.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --allow-run mod.test.ts entrypoints.test.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"]
    }
  }
}
